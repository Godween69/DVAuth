# Скопируйте в dvauth.env (он в .gitignore) и заполните. Не коммитьте dvauth.env.
# Секреты можно сгенерировать командой: openssl rand -hex 32

# --- Адреса ---
# Публичный порт: на него приходит только приложение чата (подтверждение входа). Наружу через прокси
# отдаются только /health, /v1/chat/info и /v1/chat/confirm (см. docs/DEPLOY.md).
DVAUTH_HOST=127.0.0.1
DVAUTH_PORT=3010
# Внутренний порт: API для ваших приложений. Наружу не публиковать никогда.
DVAUTH_INTERNAL_HOST=127.0.0.1
DVAUTH_INTERNAL_PORT=3011
# Сколько прокси стоит перед публичным портом (нужно, чтобы видеть настоящий адрес). Нет прокси: 0.
DVAUTH_TRUST_PROXY=0

# --- База данных (PostgreSQL) ---
DVAUTH_DATABASE_URL=postgres://dvauth:поменяй-пароль@127.0.0.1:5432/dvauth

# --- Приложения, которым разрешено пользоваться сервисом ---
# JSON-массив. id: a-z, 0-9, _ и -. secret: не короче 32 символов, у каждого приложения свой.
DVAUTH_CLIENTS=[{"id":"cloud","title":"DV Cloud","secret":"поменяй-секрет-не-короче-32-символов"}]

# --- Способ 1: коды из приложения-аутентификатора (TOTP) ---
# Ключ шифрования секретов TOTP в базе, не короче 32 символов. Потеряете ключ: коды придётся
# включать заново. Пусто: способ выключен.
DVAUTH_TOTP_KEY=

# --- Способ 2: подтверждение входа в чате на Matrix ---
# Имя вашего Matrix-сервера (часть после двоеточия в @имя:сервер) и адрес Synapse, с которого
# этот сервис может его опросить (обычно внутренний, например http://127.0.0.1:8008).
# Оба значения задаются вместе. Пусто: способ выключен. Нужен хотя бы один из двух способов.
DVAUTH_MATRIX_SERVER_NAME=
DVAUTH_MATRIX_URL=
